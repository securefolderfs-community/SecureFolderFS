<UserControl
    x:Class="SecureFolderFS.Uno.UserControls.InterfaceRoot.JournalRootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:SecureFolderFS.Uno.Helpers"
    xmlns:l="using:SecureFolderFS.Uno.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:tuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:uc="using:SecureFolderFS.Uno.UserControls"
    xmlns:ucj="using:SecureFolderFS.Uno.UserControls.Journal"
    xmlns:vmj="using:SecureFolderFS.Sdk.ViewModels.Controls.Widgets.Journal"
    RequestedTheme="{x:Bind h:UnoThemeHelper.Instance.CurrentElementTheme, Mode=OneWay}"
    mc:Ignorable="d not_win">

    <UserControl.Resources>
        <!--  Toolbar button  -->
        <Style x:Key="FormatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource JournalFontFamily}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!--  Context menu of a sidebar entry, shared by all of them. The entry is taken from its target  -->
        <MenuFlyout x:Key="EntryMenu" Opening="EntryMenu_Opening">
            <MenuFlyoutItem Click="EntryMenuOpenExternally_Click" Text="{l:ResourceString Rid=OpenInExternalApp}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="EntryMenuReveal_Click" Tag="Reveal">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="EntryMenuDelete_Click"
                Tag="Delete"
                Text="{l:ResourceString Rid=DeleteEntry}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!--  Container of a sidebar entry. The entry draws its own selection (see below)  -->
        <Style x:Key="EntryContainerStyle" TargetType="ListViewItem">
            <Setter Property="ContextFlyout" Value="{StaticResource EntryMenu}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--  Entry in the sidebar with selection UI. TODO: Maybe remove in Uno 7?  -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="vmj:JournalEntryViewModel">
            <Grid>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Rectangle
                    Width="3"
                    Height="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid Padding="8,10,8,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource JournalFontFamily}"
                            FontSize="20"
                            Text="{x:Bind DayText, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            CharacterSpacing="80"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind MonthText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontFamily="{StaticResource JournalFontFamily}"
                            FontSize="15"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Text="{x:Bind Snippet, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Snippet, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--  Root  -->
    <Grid not_win:Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Titlebar  -->
        <uc:TitleBarControl
            x:Name="CustomTitleBar"
            Grid.Row="0"
            x:FieldModifier="public"
            Canvas.ZIndex="10"
            PrimaryTitle="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <!--  Setup, until the journal has a folder  -->
        <Grid
            Grid.Row="1"
            Padding="32"
            Visibility="{x:Bind ViewModel.IsConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}">
            <StackPanel
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource JournalFontFamily}"
                    FontSize="30"
                    Text="{l:ResourceString Rid=JournalWidget}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource JournalFontFamily}"
                    FontSize="17"
                    FontStyle="Italic"
                    Text="{l:ResourceString Rid=JournalSetupTitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{l:ResourceString Rid=JournalSetupDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CreateDefaultFolderCommand, Mode=OneWay}"
                        Content="{l:ResourceString Rid=CreateJournalFolder}"
                        IsEnabled="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolInvertConverter}}"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneWay}"
                        Content="{l:ResourceString Rid=ChooseJournalFolder}" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>
        </Grid>

        <!--  Journal  -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Grid
                Grid.Column="0"
                Padding="12,4,12,12"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--  Journal folder shown, and its management  -->
                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:ResourceString Rid=JournalFolders}"
                        ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vmj:JournalFolderViewModel">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Width="34"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="{l:ResourceString Rid=JournalFolders}"
                        ToolTipService.ToolTip="{l:ResourceString Rid=JournalFolders}">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel MinWidth="260" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{l:ResourceString Rid=JournalFolders}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ManagedFolders, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmj:JournalFolderViewModel">
                                                <Grid Padding="0,2" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE8B7;" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind RelativePath, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        AutomationProperties.Name="{l:ResourceString Rid=Remove}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{x:Bind RemoveCommand, Mode=OneWay}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="{l:ResourceString Rid=RemoveJournalFolder}">
                                                        <FontIcon FontSize="11" Glyph="&#xE738;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneWay}"
                                        Content="{l:ResourceString Rid=AddJournalFolder}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--  New entry  -->
                <Button
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.NewEntryCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolInvertConverter}}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                        <TextBlock Text="{l:ResourceString Rid=NewEntry}" />
                    </StackPanel>
                </Button>

                <!--  Entries  -->
                <ListView
                    Grid.Row="2"
                    Margin="-8,0,-8,0"
                    IsItemClickEnabled="True"
                    ItemClick="EntriesList_ItemClick"
                    ItemContainerStyle="{StaticResource EntryContainerStyle}"
                    ItemTemplate="{StaticResource EntryTemplate}"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    SelectionMode="None" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource JournalFontFamily}"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{l:ResourceString Rid=JournalNoEntries}"
                    Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}" />
            </Grid>

            <!--  Paper page  -->
            <Border
                x:Name="Paper"
                Grid.Column="1"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <!--  Nothing open  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource JournalFontFamily}"
                        FontSize="17"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{l:ResourceString Rid=SelectEntryHint}"
                        Visibility="{x:Bind ViewModel.IsEntryOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}" />

                    <!--  Open entry  -->
                    <Grid Visibility="{x:Bind ViewModel.IsEntryOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <Grid
                            x:Name="Toolbar"
                            Grid.Row="0"
                            Padding="16,10,16,6"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Formatting, only while writing  -->
                            <StackPanel
                                x:Name="FormattingButtons"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="1">
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatBold}"
                                    Click="FormatBold_Click"
                                    Content="B"
                                    FontWeight="Bold"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatBold}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatItalic}"
                                    Click="FormatItalic_Click"
                                    Content="I"
                                    FontStyle="Italic"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatItalic}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatStrikethrough}"
                                    Click="FormatStrikethrough_Click"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatStrikethrough}">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </Button>
                                <Rectangle
                                    Width="1"
                                    Height="16"
                                    Margin="6,0"
                                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatHeading}"
                                    Click="FormatHeading_Click"
                                    Content="H1"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatHeading}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatSubheading}"
                                    Click="FormatSubheading_Click"
                                    Content="H2"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatSubheading}" />
                                <Rectangle
                                    Width="1"
                                    Height="16"
                                    Margin="6,0"
                                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatBulletedList}"
                                    Click="FormatBulletedList_Click"
                                    Content="•"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatBulletedList}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatNumberedList}"
                                    Click="FormatNumberedList_Click"
                                    Content="1."
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatNumberedList}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatChecklist}"
                                    Click="FormatChecklist_Click"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatChecklist}">
                                    <!--  A drawn tick box, independent of the icon font  -->
                                    <Grid Width="13" Height="13">
                                        <Rectangle
                                            RadiusX="2"
                                            RadiusY="2"
                                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                            StrokeThickness="1.2" />
                                        <Path
                                            Data="M3,6.5 L5.5,9 L10,4"
                                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.4" />
                                    </Grid>
                                </Button>
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatQuote}"
                                    Click="FormatQuote_Click"
                                    Content="“"
                                    FontSize="22"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatQuote}" />
                                <Rectangle
                                    Width="1"
                                    Height="16"
                                    Margin="6,0"
                                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatCode}"
                                    Click="FormatCode_Click"
                                    Content="&lt;/&gt;"
                                    FontSize="12"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatCode}" />
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatLink}"
                                    Click="FormatLink_Click"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatLink}">
                                    <TextBlock Text="a" TextDecorations="Underline" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatImage}"
                                    Click="InsertImage_Click"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatImage}">
                                    <!--  A drawn picture frame, independent of the icon font  -->
                                    <Viewbox Width="15" Height="12">
                                        <Canvas Width="16" Height="12">
                                            <Rectangle
                                                Width="16"
                                                Height="12"
                                                RadiusX="2"
                                                RadiusY="2"
                                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                StrokeThickness="1.3" />
                                            <Polygon Fill="{ThemeResource TextFillColorPrimaryBrush}" Points="2.5,10 6,5.5 8.5,8 10.5,6 13.5,10" />
                                            <Ellipse
                                                Canvas.Left="10"
                                                Canvas.Top="2.5"
                                                Width="2.4"
                                                Height="2.4"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button
                                    AutomationProperties.Name="{l:ResourceString Rid=FormatDivider}"
                                    Click="FormatDivider_Click"
                                    Content="—"
                                    Style="{StaticResource FormatButtonStyle}"
                                    ToolTipService.ToolTip="{l:ResourceString Rid=FormatDivider}" />
                            </StackPanel>

                            <tuc:Segmented
                                x:Name="ModeSelector"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                SelectedIndex="0"
                                SelectionChanged="ModeSelector_SelectionChanged">
                                <tuc:SegmentedItem Content="{l:ResourceString Rid=Write}" />
                                <tuc:SegmentedItem Content="{l:ResourceString Rid=Preview}" />
                            </tuc:Segmented>

                            <!--  Delete, confirmed in place so the prompt opens in this window  -->
                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:ResourceString Rid=DeleteEntry}"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolInvertConverter}}"
                                ToolTipService.ToolTip="{l:ResourceString Rid=DeleteEntry}">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <Button.Flyout>
                                    <Flyout x:Name="DeleteFlyout" Placement="BottomEdgeAlignedRight">
                                        <StackPanel MaxWidth="260" Spacing="12">
                                            <TextBlock Text="{l:ResourceString Rid=DeleteEntryConfirmation}" TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Click="DeleteConfirmButton_Click"
                                                Command="{x:Bind ViewModel.DeleteEntryCommand, Mode=OneWay}"
                                                Content="{l:ResourceString Rid=Delete}"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!--  The page itself, set in a comfortable reading column  -->
                        <Grid
                            Grid.Row="1"
                            MaxWidth="760"
                            Padding="40,12,40,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontFamily="{StaticResource JournalFontFamily}"
                                FontSize="14"
                                FontStyle="Italic"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.EntryDateText, Mode=OneWay}" />

                            <TextBox
                                x:Name="TitleBox"
                                Grid.Row="1"
                                Margin="-10,6,-10,0"
                                AcceptsReturn="False"
                                AutomationProperties.Name="{l:ResourceString Rid=EntryTitlePlaceholder}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{StaticResource JournalFontFamily}"
                                FontSize="30"
                                IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                KeyDown="TitleBox_KeyDown"
                                PlaceholderText="{l:ResourceString Rid=EntryTitlePlaceholder}"
                                Text="{x:Bind ViewModel.EntryTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Border
                                x:Name="TitleRule"
                                Grid.Row="2"
                                Height="1"
                                Margin="0,10,0,12" />

                            <TextBox
                                x:Name="BodyBox"
                                Grid.Row="3"
                                Margin="-10,0,-10,0"
                                AcceptsReturn="True"
                                AutomationProperties.Name="{l:ResourceString Rid=EntryBodyPlaceholder}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{StaticResource JournalFontFamily}"
                                FontSize="17"
                                IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                IsSpellCheckEnabled="True"
                                PlaceholderText="{l:ResourceString Rid=EntryBodyPlaceholder}"
                                PreviewKeyDown="BodyBox_PreviewKeyDown"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{x:Bind ViewModel.EntryBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.IsPreviewing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}" />

                            <ScrollViewer
                                Grid.Row="3"
                                Margin="0,6,0,0"
                                Visibility="{x:Bind ViewModel.IsPreviewing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ucj:MarkdownView
                                    x:Name="Preview"
                                    Margin="0,0,0,24"
                                    FontFamily="{StaticResource JournalFontFamily}"
                                    FontSize="17"
                                    Markdown="{x:Bind ViewModel.EntryBody, Mode=OneWay}" />
                            </ScrollViewer>
                        </Grid>

                        <!--  Status  -->
                        <Grid
                            Grid.Row="2"
                            Padding="20,6,20,10"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}" />

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
