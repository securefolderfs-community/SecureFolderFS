<ContentDialog
    x:Class="SecureFolderFS.Uno.Dialogs.ApiConsentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:SecureFolderFS.Uno.Helpers"
    xmlns:l="using:SecureFolderFS.Uno.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="using:System"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanContinue, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
    RequestedTheme="{x:Bind h:UnoThemeHelper.Instance.CurrentElementTheme, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel MaxWidth="420" Spacing="12">

        <!--  Who is asking  -->
        <StackPanel Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.ClientName, Mode=OneWay, Converter={StaticResource StringInterpolationConverter}, ConverterParameter='inverseMode:LOCALIZE|ApiConsentDescription'}"
                TextWrapping="Wrap" />

            <TextBlock
                FontSize="12"
                Opacity="0.8"
                Text="{x:Bind ViewModel.ExecutablePath, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{x:Bind ViewModel.ExecutablePath, Mode=OneWay}" />
        </StackPanel>

        <!--  Identity information  -->
        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.IdentityDescription}"
            Severity="{x:Bind IdentitySeverity}" />

        <!--  What is being granted  -->
        <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{l:ResourceString Rid=ApiConsentPermissionsHeader}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.RequestedPermissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock
                            Margin="0,2,0,0"
                            Text="{x:Bind}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Precaution info  -->
        <TextBlock
            FontSize="12"
            Opacity="0.8"
            Text="{l:ResourceString Rid=ApiConsentFooter}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
