<ContentDialog
    x:Class="SecureFolderFS.Uno.Dialogs.RestorationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:SecureFolderFS.Uno.Helpers"
    xmlns:l="using:SecureFolderFS.Uno.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:SecureFolderFS.Uno.UserControls"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    CloseButtonText="{l:ResourceString Rid=Cancel}"
    Closing="ContentDialog_Closing"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="{l:ResourceString Rid=RestoreVault}"
    RequestedTheme="{x:Bind h:UnoThemeHelper.Instance.CurrentElementTheme, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="32">
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsAwaitingConfirmation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{l:ResourceString Rid=RestorationTitle}" />

            <TextBlock
                Opacity="0.6"
                Text="{l:ResourceString Rid=RestorationDescription}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <uc:RecoveryControl
            PasteRecoveryKeyCommand="{x:Bind ViewModel.PasteRecoveryKeyCommand, Mode=OneWay}"
            RecoveryKey="{x:Bind ViewModel.RecoveryKey, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.IsAwaitingConfirmation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

        <!--  The detected parameters are confirmed before the rebuilt configuration is signed with the vault's own MAC key  -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsAwaitingConfirmation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{l:ResourceString Rid=RestorationConfirmTitle}"
                Severity="Warning" />

            <TextBlock
                Opacity="0.6"
                Text="{l:ResourceString Rid=RestorationConfirmDescription}"
                TextWrapping="WrapWholeWords" />

            <Grid ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Opacity="0.6"
                    Text="{l:ResourceString Rid=DataEncryption}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.DetectedParameters.ContentCipherId, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Opacity="0.6"
                    Text="{l:ResourceString Rid=NameEncryption}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.DetectedFileNameCipher, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Opacity="0.6"
                    Text="{l:ResourceString Rid=NameShortening}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.DetectedParameters.ShorteningThreshold, Mode=OneWay}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsFileNameEncryptionMissing, Mode=OneWay}"
                Message="{l:ResourceString Rid=RestorationNoFileNameEncryption}"
                Severity="Error" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
