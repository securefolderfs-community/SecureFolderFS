<Page
    x:Class="SecureFolderFS.Uno.Views.Settings.PreferencesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:SecureFolderFS.Uno.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:SecureFolderFS.Uno.UserControls"
    xmlns:ucab="using:SecureFolderFS.Uno.UserControls.ActionBlocks"
    xmlns:vm="using:SecureFolderFS.Sdk.ViewModels.Controls.Components"
    xmlns:vm2="using:SecureFolderFS.Sdk.ViewModels.Controls"
    mc:Ignorable="d">

    <Grid Loaded="Root_Loaded" RowSpacing="12">
        <Grid.RowDefinitions>
            <!--  Banner  -->
            <RowDefinition Height="Auto" />
            <!--  Other settings  -->
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Banner  -->
        <uc:BannerControl Grid.Row="0">
            <uc:BannerControl.LeftSide>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{l:ResourceString Rid=FileSystemProvider}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.8"
                        Text="{l:ResourceString Rid=FileSystemProviderDescription}" />
                </StackPanel>
            </uc:BannerControl.LeftSide>
            <uc:BannerControl.RightSide>
                <ComboBox
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.BannerViewModel.SelectedItem, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.BannerViewModel.FileSystemAdapters, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.BannerViewModel.SelectedItem, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileSystemItemViewModel">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </uc:BannerControl.RightSide>
            <uc:BannerControl.AdditionalBottomContent>
                <!--  File system InfoBar  -->
                <InfoBar
                    IsClosable="{x:Bind ViewModel.BannerViewModel.FileSystemInfoBar.IsCloseable, Mode=OneWay}"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.BannerViewModel.FileSystemInfoBar.Message, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.BannerViewModel.FileSystemInfoBar.Severity, Mode=OneWay, Converter={StaticResource GenericEnumConverter}}"
                    Visibility="{x:Bind ViewModel.BannerViewModel.FileSystemInfoBar.IsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <InfoBar.ActionButton>
                        <Button
                            HorizontalAlignment="Right"
                            Click="WebDavApply_Click"
                            Content="Apply"
                            Visibility="{x:Bind IsWebDavApplyVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </InfoBar.ActionButton>
                    <anim:Implicit.ShowAnimations>
                        <anim:TranslationAnimation
                            From="0,-15,0"
                            To="0"
                            Duration="0:0:0.4" />
                        <anim:OpacityAnimation
                            From="0"
                            To="1.0"
                            Duration="0:0:0.6" />
                    </anim:Implicit.ShowAnimations>
                    <anim:Implicit.HideAnimations>
                        <anim:OpacityAnimation
                            From="1.0"
                            To="0.0"
                            Duration="0:0:0.2" />
                        <anim:TranslationAnimation
                            From="0"
                            To="0,-15,0"
                            Duration="0:0:0.2" />
                    </anim:Implicit.HideAnimations>
                </InfoBar>
            </uc:BannerControl.AdditionalBottomContent>
        </uc:BannerControl>

        <!--  Other settings  -->
        <StackPanel Grid.Row="1" Spacing="4">
            <ucab:ActionBlockControl
                Title="{l:ResourceString Rid=AutoStart}"
                BlockMode="Default"
                Description="{l:ResourceString Rid=AutoStartDescription}">
                <ucab:ActionBlockControl.Icon>
                    <FontIcon Glyph="&#xF71C;" />
                </ucab:ActionBlockControl.Icon>
                <ucab:ActionBlockControl.ActionElement>
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="{l:ResourceString Rid=AutoStart}"
                        IsOn="{x:Bind ViewModel.StartOnSystemStartup, Mode=TwoWay}" />
                </ucab:ActionBlockControl.ActionElement>
            </ucab:ActionBlockControl>
            <ucab:ActionBlockControl
                Title="{l:ResourceString Rid=PutToBackground}"
                BlockMode="Default"
                Description="{l:ResourceString Rid=PutToBackgroundDescription}">
                <ucab:ActionBlockControl.Icon>
                    <FontIcon Glyph="&#xE75B;" />
                </ucab:ActionBlockControl.Icon>
                <ucab:ActionBlockControl.ActionElement>
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="{l:ResourceString Rid=PutToBackground}"
                        IsOn="{x:Bind ViewModel.ReduceToBackground, Mode=TwoWay}" />
                </ucab:ActionBlockControl.ActionElement>
            </ucab:ActionBlockControl>
            <ucab:ActionBlockControl
                Title="{l:ResourceString Rid=RestoreLastSession}"
                BlockMode="Default"
                Description="{l:ResourceString Rid=RestoreLastSessionDescription}">
                <ucab:ActionBlockControl.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </ucab:ActionBlockControl.Icon>
                <ucab:ActionBlockControl.ActionElement>
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="{l:ResourceString Rid=RestoreLastSession}"
                        IsOn="{x:Bind ViewModel.ContinueOnLastVault, Mode=TwoWay}" />
                </ucab:ActionBlockControl.ActionElement>
            </ucab:ActionBlockControl>
            <ucab:ActionBlockControl
                Title="{l:ResourceString Rid=OpenVaultFolder}"
                BlockMode="Default"
                Description="{l:ResourceString Rid=OpenVaultFolderDescription}">
                <ucab:ActionBlockControl.Icon>
                    <FontIcon Glyph="&#xED25;" />
                </ucab:ActionBlockControl.Icon>
                <ucab:ActionBlockControl.ActionElement>
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="{l:ResourceString Rid=OpenVaultFolder}"
                        IsOn="{x:Bind ViewModel.OpenFolderOnUnlock, Mode=TwoWay}" />
                </ucab:ActionBlockControl.ActionElement>
            </ucab:ActionBlockControl>

            <!--  Integrations API  -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.AreIntegrationsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ucab:ActionBlockControl
                    Title="{l:ResourceString Rid=LocalIntegrations}"
                    BlockMode="Default"
                    Description="{l:ResourceString Rid=LocalIntegrationsDescription}">
                    <ucab:ActionBlockControl.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </ucab:ActionBlockControl.Icon>
                    <ucab:ActionBlockControl.ActionElement>
                        <ToggleSwitch
                            MinWidth="0"
                            AutomationProperties.Name="{l:ResourceString Rid=LocalIntegrations}"
                            IsOn="{x:Bind ViewModel.EnableLocalIntegrations, Mode=TwoWay}" />
                    </ucab:ActionBlockControl.ActionElement>
                </ucab:ActionBlockControl>

                <!--  Authorized applications, shown only while integrations are switched on  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.EnableLocalIntegrations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="4,8,4,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{l:ResourceString Rid=ConnectedApps}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.RevokeAllAppsCommand}"
                            Content="{l:ResourceString Rid=RevokeAllAccess}" />
                    </Grid>

                    <TextBlock
                        Margin="4,0"
                        Opacity="0.8"
                        Text="{l:ResourceString Rid=NoConnectedApps}"
                        Visibility="{x:Bind ViewModel.ConnectedApps.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectedApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm2:IntegrationClientViewModel">
                                <Grid
                                    Margin="0,2"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="8"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.8"
                                            Text="{x:Bind IdentityDescription}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.8"
                                            Text="{x:Bind ExecutablePath}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ExecutablePath}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind RevokeCommand, Mode=OneWay}"
                                        Content="{l:ResourceString Rid=RevokeAccess}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
